# 可选：也可以直接通过界面配置。不要在公开文件中填写真实密钥。
# 在本地 .env 或进程环境中定义 QWEN_API_KEY；也可使用私有文件路径。
JOB_AGENT_API_KEY_ENV=QWEN_API_KEY
JOB_AGENT_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
JOB_AGENT_MODEL=qwen3.7-flash
# 以下为本项目使用过的估算费率，不承诺为当前服务报价。
JOB_AGENT_INPUT_CNY_PER_MILLION=0.2
JOB_AGENT_OUTPUT_CNY_PER_MILLION=0.8
JOB_AGENT_BUDGET_CNY=10
GRADIO_ANALYTICS_ENABLED=False
# JOB_AGENT_API_KEY_FILE=workspace/secrets/model-api-key
# JOB_AGENT_BUDGET_DB=workspace/custom-budget.sqlite

# DeepSeek：同时替换服务地址、模型、密钥变量及估算费率。
# JOB_AGENT_API_KEY_ENV=DEEPSEEK_API_KEY
# JOB_AGENT_BASE_URL=https://api.deepseek.com
# JOB_AGENT_MODEL=deepseek-flash
# JOB_AGENT_INPUT_CNY_PER_MILLION=2
# JOB_AGENT_OUTPUT_CNY_PER_MILLION=8

# BOSS：优先在界面准备组件。WSL 桥接需配置 Windows Python 可执行文件。
# JOB_AGENT_CDP_PYTHON=/path/to/windows/python.exe
# JOB_AGENT_CDP_UPSTREAM=workspace/tools/boss-cdp/scripts/boss_cdp_raw.py
